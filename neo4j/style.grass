/* GraSS style for Neo4j Browser. Load it by dragging this file onto the Browser window, or paste it after `:style`.
   Colours follow the app's dark palette; risk colours are reserved for UserWeek nodes. */
node {
  diameter: 40px;
  color: #8196b0;
  border-color: #5c7794;
  border-width: 2px;
  text-color-internal: #0b1017;
  font-size: 10px;
  caption: "{name}";
}
node.User { diameter: 30px; color: #6f7d90; border-color: #4f5b6b; caption: "{id}"; text-color-internal: #ffffff; }
node.UserWeek { diameter: 56px; color: #e96a36; border-color: #f9b36a; border-width: 3px; caption: "{user}"; text-color-internal: #0b1017; font-size: 11px; }
node.PC { diameter: 30px; color: #a39e93; border-color: #7a756a; caption: "{id}"; }
node.Domain { diameter: 40px; color: #8196b0; border-color: #5c7794; caption: "{name}"; }
relationship {
  color: #7d8a9b;
  shaft-width: 1px;
  font-size: 8px;
  padding: 3px;
  text-color-external: #a8b3c1;
  text-color-internal: #ffffff;
  caption: "<type>";
}
relationship.LOGGED_ON { color: #7d8a9b; shaft-width: 1px; }
relationship.VISITED { color: #5c7794; shaft-width: 2px; }
relationship.EMAILED { color: #4aa3ff; shaft-width: 2px; }
relationship.HAS_WEEK { color: #263042; shaft-width: 1px; }
